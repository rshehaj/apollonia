# Copy to backend/.env and adjust.
APOLLONIA_DATABASE_URL=postgresql+psycopg://apollonia:apollonia@localhost:5433/apollonia

# "bge-m3" (requires `uv sync --extra embeddings`) or "fake" (tests / quick demos)
APOLLONIA_EMBEDDER=bge-m3

# Wikimedia asks every client to identify itself with a contact:
# https://meta.wikimedia.org/wiki/User-Agent_policy
APOLLONIA_WIKIPEDIA_USER_AGENT=Apollonia/0.1 (https://github.com/YOUR_USERNAME/apollonia)
