{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(scripts/check.sh:*)",
      "Bash(./scripts/check.sh:*)",
      "Bash(docker compose:*)",
      "Bash(docker info:*)",
      "Bash(docker ps:*)"
    ],
    "deny": [
      "Bash(git:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
